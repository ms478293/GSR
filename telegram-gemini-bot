import os
import requests
from telegram import Update
from telegram.ext import ApplicationBuilder, MessageHandler, ContextTypes, filters

BOT_TOKEN = os.environ["8244220892:AAGjGawxQ7131nhLM8uyUhG6fmp7SkP11FE"]
GEMINI_API_KEY = os.environ["AIzaSyBJ8P_gat-g0nsAqVrLn3nlB8vClCm6FiI"]

def ask_gemini(prompt: str) -> str:
    url = "https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent"
    params = {"key": GEMINI_API_KEY}
    headers = {"Content-Type": "application/json"}
    payload = {"contents": [{"parts": [{"text": prompt}]}]}

    r = requests.post(url, params=params, headers=headers, json=payload, timeout=60)
    r.raise_for_status()
    data = r.json()

    # safest parsing
    try:
        return data["candidates"][0]["content"]["parts"][0]["text"].strip()
    except Exception:
        return "Sorry — I couldn't generate a response right now."

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = (update.message.text or "").strip()
    if not text:
        return
    await update.message.chat.send_action("typing")
    reply = ask_gemini(text)
    await update.message.reply_text(reply)

def main():
    app = ApplicationBuilder().token(BOT_TOKEN).build()
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    app.run_polling(close_loop=False)

if __name__ == "__main__":
    main()
